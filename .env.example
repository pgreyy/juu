# Juu settings. Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Testnet only. On the server: /home/juu/juu/.env, owned by juu, mode 600 (chmod 600 .env).

# ---------------------------------------------------------------- server (keeper, Data API, MCP server)
# Mezo testnet RPC.
MEZO_RPC_URL=https://rpc.test.mezo.org
# Keeper bot wallet key (0x...). The only key the server needs. Keep a little testnet BTC on it for gas.
KEEPER_KEY=
# Data API port (listens on 127.0.0.1 only).
JUU_API_PORT=8788
# Sites allowed to read the Data API from the browser, comma-separated, no trailing slash.
CORS_ORIGINS=https://playjuu.xyz,https://app.playjuu.xyz
# Set to 1 to serve the API and scan events without sending any keeper transaction.
KEEPER_DRY_RUN=0

# Juu's Cloudflare tunnel token (Cloudflare dashboard, Zero Trust, Networks, Tunnels, "juu"). deploy/tunnel.sh reads it
# from here; it never goes on a command line or into git.
TUNNEL_TOKEN=

# MCP server. pm2 starts it over HTTP on 127.0.0.1:8789 (MCP_HTTP_PORT is set in deploy/ecosystem.config.cjs).
# Which stack its tools use: main or demo.
JUU_STACK=main
# Where it reads the Data API.
JUU_API_URL=http://127.0.0.1:8788
# Optional: an AGENT's own key (a fresh wallet a user granted a session to in the Agent Gateway). Never a user's main
# wallet key. Leave empty for a read-only MCP server.
AGENT_PRIVATE_KEY=
# Bearer token MCP clients must send (Authorization: Bearer <token>). Required if AGENT_PRIVATE_KEY is set.
# Make one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------- laptop only (never on the server)
# Testnet deployer key and address, used by the Foundry deploy scripts and scripts/send.sh.
PRIVATE_KEY=
DEPLOYER=
# Optional faucet helper wallets for scripts/sweep-funders.sh.
FUNDER1_KEY=
FUNDER1_ADDR=
FUNDER2_KEY=
FUNDER2_ADDR=
# Optional test agent key and address used in testing the Agent Gateway.
AGENT1_KEY=
AGENT1_ADDR=
# Keeper address (for reference; the keeper key is above).
KEEPER_ADDR=
